rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == userId
        && incoming().mentorStyle is string && incoming().mentorStyle.size() <= 50
        && incoming().dailyGoalMinutes is int && incoming().dailyGoalMinutes >= 0 && incoming().dailyGoalMinutes <= 720;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'mentorStyle', 'dailyGoalMinutes', 'updatedAt', 'preferredTheme']);
      allow delete: if isOwner(userId);

      // Conversations subcollection
      match /conversations/{conversationId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(conversationId)
          && incoming().userId == userId
          && incoming().title is string && incoming().title.size() <= 200
          && incoming().mentorStyle is string && incoming().mentorStyle.size() <= 50;
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mentorStyle', 'updatedAt', 'lastMessagePreview', 'messageCount']);
        allow delete: if isOwner(userId);

        // Messages subcollection
        match /messages/{messageId} {
          allow list, get: if isOwner(userId);
          allow create: if isOwner(userId)
            && isValidId(messageId)
            && incoming().userId == userId
            && incoming().conversationId == conversationId
            && incoming().role is string && (incoming().role == 'user' || incoming().role == 'model')
            && incoming().content is string && incoming().content.size() <= 12000;
          allow update: if false; // Messages are immutable once written
          allow delete: if isOwner(userId);
        }
      }

      // Learning Plans subcollection
      match /learningPlans/{planId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(planId)
          && incoming().userId == userId
          && incoming().topic is string && incoming().topic.size() <= 200
          && incoming().level is string && incoming().level.size() <= 50;
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['completedModuleIds', 'updatedAt', 'summary', 'estimatedHours', 'modules']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
